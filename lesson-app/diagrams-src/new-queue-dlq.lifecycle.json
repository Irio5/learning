      { "id": "guasti", "label": "Guasti", "focus": ["processing", "retry", "dlq"], "note": "Cosa succede quando l'elaborazione fallisce." }
    ]
  },
  "lanes": [
    { "id": "main", "label": "Elaborazione" },
    { "id": "guasti", "label": "Guasti" }
