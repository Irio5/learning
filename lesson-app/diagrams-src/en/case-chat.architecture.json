  "cards": [
    {
      "dot": "amber",
      "title": "Key trade-offs",
      "items": [
        "Chat server: WebSocket (push, minimal latency) vs polling (simple but late and wasteful).",
        "Message + Inbox: TTL on the inbox (e.g. 30 days): simple cleanup, but the edge has to be handled.",
        "Redis Pub/Sub: Pub/Sub (light) vs Kafka (persistent but heavier). A connection→server registry says where to route.",
        "Client B: Strict ordering (complex) vs server timestamp (simple, rarely out of order)."
      ]
    }
