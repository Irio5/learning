{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "One round of the crawler",
    "subtitle": "Who calls whom, step by step",
    "output": "seq-crawler.en.html",
    "viewBox": [
      825,
      500
    ],
    "visual_preset": "blueprint",
    "animation": "trace",
    "quality_profile": "standard"
  },
  "participants": [
    {
      "id": "frontier",
      "type": "messagebus",
      "label": "URL frontier"
    },
    {
      "id": "fetcher",
      "type": "backend",
      "label": "Fetcher"
    },
    {
      "id": "redis",
      "type": "database",
      "label": "Redis"
    },
    {
      "id": "parser",
      "type": "backend",
      "label": "Parser"
    },
    {
      "id": "seen",
      "type": "database",
      "label": "Seen set"
    }
  ],
  "messages": [
    {
      "id": "m0",
      "from": "frontier",
      "to": "fetcher",
      "y": 170,
      "label": "next URL",
      "variant": "default"
    },
    {
      "id": "m1",
      "from": "fetcher",
      "to": "redis",
      "y": 210,
      "label": "robots? rate?",
      "variant": "default"
    },
    {
      "id": "m2",
      "from": "redis",
      "to": "fetcher",
      "y": 250,
      "label": "ok, go ahead",
      "variant": "return",
      "note": "GET page → S3 — It downloads the HTML and saves it in the object store (S3): it's large, it doesn't go in the DB."
    },
    {
      "id": "m3",
      "from": "fetcher",
      "to": "parser",
      "y": 290,
      "label": "html",
      "variant": "default"
    },
    {
      "id": "m4",
      "from": "parser",
      "to": "seen",
      "y": 330,
      "label": "link already seen? (bloom)",
      "variant": "default"
    },
    {
      "id": "m5",
      "from": "seen",
      "to": "parser",
      "y": 370,
      "label": "only the new ones",
      "variant": "return"
    },
    {
      "id": "m6",
      "from": "parser",
      "to": "frontier",
      "y": 410,
      "label": "enqueue new URLs",
      "variant": "dashed"
    }
  ],
  "activations": [
    {
      "participant": "fetcher",
      "from": 170,
      "to": 210,
      "type": "backend"
    },
    {
      "participant": "redis",
      "from": 210,
      "to": 250,
      "type": "database"
    },
    {
      "participant": "fetcher",
      "from": 250,
      "to": 290,
      "type": "backend"
    },
    {
      "participant": "parser",
      "from": 290,
      "to": 330,
      "type": "backend"
    },
    {
      "participant": "seen",
      "from": 330,
      "to": 370,
      "type": "database"
    },
    {
      "participant": "parser",
      "from": 370,
      "to": 410,
      "type": "backend"
    }
  ]
}