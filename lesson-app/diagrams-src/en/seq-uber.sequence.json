{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Update the location, then match",
    "subtitle": "Who calls whom, step by step",
    "output": "seq-uber.en.html",
    "viewBox": [
      825,
      500
    ],
    "visual_preset": "blueprint",
    "animation": "trace",
    "quality_profile": "standard"
  },
  "participants": [
    {
      "id": "driver",
      "type": "external",
      "label": "Driver app"
    },
    {
      "id": "location",
      "type": "backend",
      "label": "Location Svc"
    },
    {
      "id": "geo",
      "type": "database",
      "label": "Geo index"
    },
    {
      "id": "matching",
      "type": "backend",
      "label": "Matching Svc"
    },
    {
      "id": "rider",
      "type": "external",
      "label": "Rider app"
    }
  ],
  "messages": [
    {
      "id": "m0",
      "from": "driver",
      "to": "location",
      "y": 170,
      "label": "pos every ~4s",
      "variant": "dashed"
    },
    {
      "id": "m1",
      "from": "location",
      "to": "geo",
      "y": 210,
      "label": "write geohash cell",
      "variant": "default"
    },
    {
      "id": "m2",
      "from": "rider",
      "to": "matching",
      "y": 250,
      "label": "request ride",
      "variant": "default"
    },
    {
      "id": "m3",
      "from": "matching",
      "to": "geo",
      "y": 290,
      "label": "nearby(cell)",
      "variant": "default"
    },
    {
      "id": "m4",
      "from": "geo",
      "to": "matching",
      "y": 330,
      "label": "nearby drivers",
      "variant": "return",
      "note": "lock TTL + pick — A distributed lock with TTL on Redis: don't assign the same driver to two rides."
    },
    {
      "id": "m5",
      "from": "matching",
      "to": "driver",
      "y": 370,
      "label": "push: new ride",
      "variant": "dashed"
    },
    {
      "id": "m6",
      "from": "matching",
      "to": "rider",
      "y": 410,
      "label": "driver assigned",
      "variant": "return"
    }
  ],
  "activations": [
    {
      "participant": "location",
      "from": 170,
      "to": 210,
      "type": "backend"
    },
    {
      "participant": "matching",
      "from": 250,
      "to": 290,
      "type": "backend"
    },
    {
      "participant": "geo",
      "from": 210,
      "to": 330,
      "type": "database"
    },
    {
      "participant": "matching",
      "from": 330,
      "to": 370,
      "type": "backend"
    },
    {
      "participant": "driver",
      "from": 370,
      "to": 410,
      "type": "external"
    }
  ]
}